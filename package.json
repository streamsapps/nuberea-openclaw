{
  "name": "@nuberea/openclaw",
  "version": "2.0.0",
  "description": "OpenClaw plugin for the NuBerea biblical data platform — exposes NuBerea MCP tools as native OpenClaw agent tools.",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "files": [
    "dist",
    "nuberea",
    "README.md",
    "LICENSE",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "nuberea",
    "bible",
    "biblical",
    "hebrew",
    "greek",
    "morphology",
    "lexicon",
    "mcp"
  ],
  "author": "NuBerea <blake@streamsapps.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/streamsapps/nuberea-openclaw.git"
  },
  "homepage": "https://nuberea.com",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.2",
      "minGatewayVersion": "2026.11.2"
    },
    "build": {
      "openclawVersion": "2026.11.2",
      "pluginSdkVersion": "2026.11.2"
    },
    "install": {
      "npmSpec": "@nuberea/openclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.11.2"
    }
  },
  "dependencies": {
    "@nuberea/sdk": "^0.1.5",
    "@sinclair/typebox": "^0.34.49"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openclaw": "2026.11.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "openclaw": {
      "minimatch@10.2.6": "^11.0.1",
      "npm@12.2.0": "12.2.2",
      "zod@4.6.5": "^4.6.6"
    }
  }
}
